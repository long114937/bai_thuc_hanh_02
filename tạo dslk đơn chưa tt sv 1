#include<stdio.h>
#include<stdlib.h>
#include<string.h>

typedef struct {
    char hoten[30];
    int masv;
    float d1, d2, d3;
} Data;

typedef struct tagNode {
    Data infor;
    struct tagNode *link;
} Node;

typedef struct {
    Node *pHead;
    Node *pTail;
    int spt;
} LList;

/////////////////////////////////////
// Khoi tao danh sach
void initList(LList *L) {
    L->pHead = NULL;
    L->pTail = NULL;
    L->spt = 0;
}

/////////////////////////////////////
// Kiem tra danh sach rong
int emptyList(LList L) {
    return (L.spt == 0);
}

/////////////////////////////////////
// Tao nut moi
Node *createNode(Data x) {
    Node pp = (Node)malloc(sizeof(Node));

    if(pp == NULL) {
        printf("Khong du bo nho!\n");
        return NULL;
    }

    pp->infor = x;
    pp->link = NULL;
    return pp;
}

/////////////////////////////////////
// Them nut vao dau danh sach
void insert_Head(LList *L, Data x) {
    Node *pp = createNode(x);

    if(pp == NULL) return;

    if(emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    }
    else {
        pp->link = L->pHead;
        L->pHead = pp;
    }

    L->spt++;
}

/////////////////////////////////////
// Them nut vao cuoi danh sach
void insert_Tail(LList *L, Data x) {
    Node *pp = createNode(x);

    if(pp == NULL) return;

    if(emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    }
    else {
        L->pTail->link = pp;
        L->pTail = pp;
    }

    L->spt++;
}

/////////////////////////////////////
// Them nut sau mot nut co ma SV cho truoc
void insert_After(LList *L, int ma, Data x) {
    Node *q = L->pHead;

    while(q != NULL && q->infor.masv != ma) {
        q = q->link;
    }

    if(q == NULL) {
        printf("Khong tim thay ma sinh vien!\n");
        return;
    }

    Node *pp = createNode(x);

    if(pp == NULL) return;

    pp->link = q->link;
    q->link = pp;

    if(q == L->pTail) {
        L->pTail = pp;
    }

    L->spt++;
}

/////////////////////////////////////
// Nhap thong tin sinh vien
int nhap(Data *x) {
    printf("Nhap ma SV (ma <= 0 de huy): ");
    scanf("%d", &x->masv);

    if(x->masv <= 0) {
        return 0;
    }

    printf("Nhap ho ten: ");
    scanf(" %29[^\n]", x->hoten);

    printf("Nhap diem mon 1: ");
    scanf("%f", &x->d1);

    printf("Nhap diem mon 2: ");
    scanf("%f", &x->d2);

    printf("Nhap diem mon 3: ");
    scanf("%f", &x->d3);

    return 1;
}

/////////////////////////////////////
// In thong tin sinh vien
void in(Data x) {
    printf("Ten: %s | Ma: %d | Diem 1: %.2f | Diem 2: %.2f | Diem 3: %.2f\n",
        x.hoten, x.masv, x.d1, x.d2, x.d3);
}

/////////////////////////////////////
// Duyet va in danh sach
void processList(LList L) {
    Node *pp = L.pHead;

    if(emptyList(L)) {
        printf("Danh sach rong!\n");
        return;
    }

    while(pp != NULL) {
        in(pp->infor);
        pp = pp->link;
    }

    printf("Tong so sinh vien: %d\n", L.spt);
}

/////////////////////////////////////
// Giai phong bo nho
void freeList(LList *L) {
    Node *pp;

    while(L->pHead != NULL) {
        pp = L->pHead;
        L->pHead = L->pHead->link;
        free(pp);
    }

    L->pTail = NULL;
    L->spt = 0;
}

/////////////////////////////////////
// Chuong trinh chinh
int main() {
    LList L;
    int kt = 0;
    int chon, ma;
    Data x;

    initList(&L);

    do {
        printf("\n===== CHUONG TRINH DSLK DON SINH VIEN =====\n");
        printf("\n1: Them nut vao dau danh sach");
        printf("\n2: Them nut vao cuoi danh sach");
        printf("\n3: Them nut vao sau mot nut khac");
        printf("\n9: Duyet danh sach");
        printf("\n0: Thoat");
        printf("\nMoi ban chon: ");

        scanf("%d", &chon);

        switch(chon) {

            case 1:
                printf("\nNhap thong tin sinh vien can them:\n");

                if(nhap(&x)) {
                    insert_Head(&L, x);
                }
                break;

            case 2:
                printf("\nNhap thong tin sinh vien can them:\n");

                if(nhap(&x)) {
                    insert_Tail(&L, x);
                }
                break;

            case 3:
                printf("\nNhap ma SV muon them phia sau: ");
                scanf("%d", &ma);

                printf("Nhap thong tin sinh vien moi:\n");

                if(nhap(&x)) {
                    insert_After(&L, ma, x);
                }
                break;

            case 9:
                printf("\nDANH SACH SINH VIEN:\n");
                processList(L);
                break;

            case 0:
                printf("Bye bye!\n");
                kt = 1;
                break;

            default:
                printf("Lua chon khong hop le!\n");
        }

    } while(kt == 0);

    freeList(&L);

    return 0;
}
