
#include <stdio.h>
#include <stdlib.h>

typedef struct {
    char hoten[30];
    int masv;
    float d1, d2, d3;
} Data;

typedef struct tagNode {
    Data infor;
    struct tagNode *link;
} Node;

typedef struct {
    Node *pHead;
    Node *pTail;
    int spt;
} LList;

// Khoi tao danh sach
void initList(LList *L) {
    L->pHead = NULL;
    L->pTail = NULL;
    L->spt = 0;
}

// Kiem tra danh sach rong
int emptyList(LList L) {
    return (L.spt == 0);
}

// Tao node moi
Node *createNode(Data x) {
    Node *pp = (Node*)malloc(sizeof(Node));

    if (pp == NULL) {
        printf("Khong du bo nho!\n");
        return NULL;
    }

    pp->infor = x;
    pp->link = NULL;

    return pp;
}

// Them node vao dau danh sach
void insert_Head(LList *L, Data x) {
    Node *pp = createNode(x);

    if (pp == NULL) return;

    if (emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    }
    else {
        pp->link = L->pHead;
        L->pHead = pp;
    }

    L->spt++;
}

// Them node vao cuoi danh sach
void insert_Tail(LList *L, Data x) {
    Node *pp = createNode(x);

    if (pp == NULL) return;

    if (emptyList(*L)) {
        L->pHead = pp;
        L->pTail = pp;
    }
    else {
        L->pTail->link = pp;
        L->pTail = pp;
    }

    L->spt++;
}

// Them node vao sau mot node co ma SV cho truoc
void insert_After(LList *L, Data x, int ma) {
    Node *p = L->pHead;

    while (p != NULL && p->infor.masv != ma) {
        p = p->link;
    }

    if (p == NULL) {
        printf("Khong tim thay ma SV!\n");
        return;
    }

    Node *pp = createNode(x);

    if (pp == NULL) return;

    pp->link = p->link;
    p->link = pp;

    if (p == L->pTail) {
        L->pTail = pp;
    }

    L->spt++;

    printf("Them thanh cong!\n");
}

// Xoa node theo ma sinh vien
void delete_Node(LList *L, int ma) {
    Node *p = L->pHead;
    Node *q = NULL;

    while (p != NULL && p->infor.masv != ma) {
        q = p;
        p = p->link;
    }

    if (p == NULL) {
        printf("Khong tim thay sinh vien!\n");
        return;
    }

    if (q == NULL) {
        L->pHead = p->link;
    }
    else {
        q->link = p->link;
    }

    if (p == L->pTail) {
        L->pTail = q;
    }

    free(p);
    L->spt--;

    printf("Xoa thanh cong!\n");
}

// Nhap thong tin sinh vien
void nhap(Data *x) {
    printf("Nhap ma SV: ");
    scanf("%d", &x->masv);

    if (x->masv > 0) {
        printf("Nhap ho ten: ");
        scanf(" %29[^\n]", x->hoten);

        printf("Nhap diem mon 1: ");
        scanf("%f", &x->d1);

        printf("Nhap diem mon 2: ");
        scanf("%f", &x->d2);

        printf("Nhap diem mon 3: ");
        scanf("%f", &x->d3);
    }
}

// In thong tin sinh vien
void in(Data x) {
    printf("Ten: %s, Ma: %d, Diem 1: %.2f, Diem 2: %.2f, Diem 3: %.2f\n",
           x.hoten, x.masv, x.d1, x.d2, x.d3);
}

// Duyet danh sach
void processList(LList L) {
    Node *pp = L.pHead;

    if (emptyList(L)) {
        printf("Danh sach rong!\n");
        return;
    }

    printf("\n===== DANH SACH SINH VIEN =====\n");

    while (pp != NULL) {
        in(pp->infor);
        pp = pp->link;
    }

    printf("Tong so sinh vien: %d\n", L.spt);
}

// Giai phong danh sach
void freeList(LList *L) {
    Node *p;

    while (L->pHead != NULL) {
        p = L->pHead;
        L->pHead = L->pHead->link;
        free(p);
    }

    L->pTail = NULL;
    L->spt = 0;
}

// Ham main
int main() {
    LList L;
    int kt = 0;
    Data x;
    int chon, ma;

    initList(&L);

    do {
        printf("\n===== CHUONG TRINH DSLK DON SV =====\n");
        printf("1: Them nut vao dau danh sach\n");
        printf("2: Them nut vao cuoi danh sach\n");
        printf("3: Them nut vao sau mot nut khac\n");
        printf("4: Xoa sinh vien theo ma SV\n");
        printf("9: Duyet danh sach\n");
        printf("0: Thoat\n");

        printf("Moi ban chon: ");
        scanf("%d", &chon);

        switch (chon) {

            case 1:
                printf("Nhap thong tin sinh vien can them:\n");
                nhap(&x);

                if (x.masv > 0) {
                    insert_Head(&L, x);
                }
                else {
                    printf("Ma sinh vien khong hop le!\n");
                }
                break;

            case 2:
                printf("Nhap thong tin sinh vien can them:\n");
                nhap(&x);

                if (x.masv > 0) {
                    insert_Tail(&L, x);
                }
                else {
                    printf("Ma sinh vien khong hop le!\n");
                }
                break;

            case 3:
                printf("Nhap ma SV muon chen phia sau: ");
                scanf("%d", &ma);

                printf("Nhap thong tin sinh vien moi:\n");
                nhap(&x);

                if (x.masv > 0) {
                    insert_After(&L, x, ma);
                }
                else {
                    printf("Ma sinh vien khong hop le!\n");
                }
                break;

            case 4:
                printf("Nhap ma SV can xoa: ");
                scanf("%d", &ma);

                delete_Node(&L, ma);
                break;

            case 9:
                processList(L);
                break;

            case 0:
                printf("Bye bye!\n");
                kt = 1;
                break;

            default:
                printf("Lua chon khong hop le!\n");
        }

    } while (kt == 0);

    freeList(&L);

    return 0;
}
